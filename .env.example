# ---------------------------------------------------------------- database
# Both URLs come from Supabase → your project → Connect (top of the dashboard).
# Same database, two different doors into it.

# DATABASE_URL — what the running app uses. Transaction pooler, port 6543.
#   ?pgbouncer=true       disables prepared statements, which the pooler can't do.
#   &connection_limit=5   size of Prisma's pool. 5 is right for one always-on
#                         container; raise it only if you add replicas.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# DIRECT_URL — used only by `prisma migrate`, which needs one connection it
# keeps for the whole migration (the transaction pooler can't give it that).
# Session pooler, port 5432. Note the different HOST from DATABASE_URL if you
# use Supabase's "Direct connection" instead — that one is IPv6-only.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------- admin
# Local development only, and entirely optional — the first visit to /login
# offers a setup form instead. Left commented out on purpose: Railway reads
# this file to suggest variables, and a placeholder admin password is the last
# thing you want it proposing for production.
#
# SEED_ADMIN_EMAIL="you@yourcompany.com"
# SEED_ADMIN_PASSWORD="pick-something-real"
# SEED_ADMIN_NAME="Your Name"

# ------------------------------------------------------------------- slack
# Optional. Without these OneSpace works exactly as before, minus the nudges
# and the slash command — nothing else changes.
#
# From your Slack app at api.slack.com/apps:
#   SLACK_BOT_TOKEN      OAuth & Permissions → Bot User OAuth Token (xoxb-…)
#   SLACK_SIGNING_SECRET Basic Information → App Credentials
#
# SLACK_BOT_TOKEN="xoxb-..."
# SLACK_SIGNING_SECRET="..."

# Where links in Slack messages point. Railway sets RAILWAY_PUBLIC_DOMAIN for
# you, so this is only needed behind a custom domain.
# APP_URL="https://onespace.revoptics.co"

# Shared secret between the app and the Railway cron service that sends the
# daily brief. Any long random string; both must hold the same one.
# CRON_SECRET="..."

# Which job this container is. Unset or "web" runs the app; "cron" sends the
# daily Slack brief once and exits. Only the Railway cron service sets it.
# ONESPACE_ROLE="cron"
