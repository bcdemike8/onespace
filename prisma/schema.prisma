// OneSpace — projects, tasks and time tracking in one place.
// Replaces the Asana (templated projects + task assignment) and
// Everhour (time against tasks + billing reports) pairing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: use the pooled connection (port 6543, ?pgbouncer=true) at runtime
  url       = env("DATABASE_URL")
  // ...and the direct connection (port 5432) for migrations.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// How a project earns. Drives what time logged to it defaults to, and how
/// reports work out what's invoiceable.
enum BillingType {
  /// Invoiced on the hours: revenue is hours x bill rate.
  HOURLY
  /// Invoiced at an agreed price: revenue is the fee, however long it takes.
  FIXED_FEE
  /// Internal work, training, goodwill. Tracked, never invoiced.
  NON_BILLABLE
}

// Where a time entry came from. The timesheet grid may only edit its own
// entries: time booked from a project page, a stopwatch or an import shows
// there as read-only, so filling in a week can add to it but never quietly
// overwrite it.
enum TimeEntrySource {
  TIMESHEET
  MANUAL
  TIMER
  IMPORT
}

// How a project is actually going, which hours and budget alone never say:
// a project can be inside its budget and still off track.
enum ProjectHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

/// Where a client email thread has got to as a piece of work.
enum MailStatus {
  /// Waiting on us. Shows on the inbox and counts as something to do.
  OPEN
  /// Dealt with - replied, or judged not to need one.
  DONE
}

/// Where a suggestion drawn from Google has got to. Nothing reaches a
/// timesheet on a guess: a meeting sits here until the person it belongs to
/// says yes.
/// Where a meeting came from. A Zoom call that was never on anyone's
/// calendar - an instant meeting, or a dial into a personal room - is real
/// billable time that the calendar sync can never see.
/**
 * What a company is to RevOptics.
 * Salesforce held this as an Account record type. The names are kept because
 * they are what everyone already says, and because the import has to land
 * 618 prospects and 365 customers in the right place without a translation
 * table nobody can remember.
 * COMPETITOR exists in the export's record types and on nothing at all - no
 * account was ever filed under it. Kept so the import can't fail on a row
 * that turns up later, not because it earns a place in the UI.
 */
enum AccountType {
  PROSPECT
  CURRENT_CUSTOMER
  PREVIOUS_CUSTOMER
  PARTNER
  COMPETITOR
}

/// Whether the work came through a partner or straight from the client.
enum DealRecordType {
  DIRECT
  PARTNER
}

/**
 * Where a deal got to.
 * Eight stages were defined; seven were ever used, and QUALIFICATION never
 * once. It is kept because the stage list is the shape of the process rather
 * than a summary of the past - dropping it would quietly remove a step from
 * the process itself.
 */
enum DealStage {
  QUALIFICATION
  DISCOVERY
  ASSIGNED
  INTRODUCTION
  PROPOSAL
  CONTRACT
  CLOSED_WON
  CLOSED_LOST
}

enum MeetingSource {
  CALENDAR
  ZOOM
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

/// Where a commitment was found. Three places produce them and they carry
/// different weight: a recap the consultant wrote afterwards is the most
/// considered statement of what was agreed, Zoom's own summary had the audio,
/// and the transcript rules are the fallback that works everywhere.
enum CommitmentSource {
  TRANSCRIPT
  ZOOM_SUMMARY
  RECAP_EMAIL
  /// Read out of the transcript by Claude, with a summary kept alongside.
  AI_SUMMARY
}

// ---------------------------------------------------------------- people

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role    @default(MEMBER)
  isActive     Boolean @default(true)

  // Rates are stored in cents per hour to keep money in integers.
  // costRate = what this person actually costs you (salary loaded, or contractor pay).
  // billRate = default rate you charge a client for their time.
  costRateCents Int @default(0)
  billRateCents Int @default(0)

  /// Slack member id (U…), matched from this person's email. Null until the
  /// workspace is linked, or when someone has no Slack account.
  slackUserId String? @unique

  /// The last time this person actually got in. Null means never, which is
  /// the single most useful fact when somebody says "it doesn't work" - it
  /// separates "their password is wrong" from "they never tried".
  lastSignedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  assignedTasks Task[]         @relation("TaskAssignee")
  timeEntries   TimeEntry[]
  timer         RunningTimer?
  templateTasks TemplateTask[] @relation("TemplateDefaultAssignee")
  ownedProjects Project[]      @relation("ProjectOwner")
  statusUpdates StatusUpdate[] @relation("StatusUpdateAuthor")
  meetings      Meeting[]
  mailThreads   MailThread[]

  // The CRM. Salesforce spread ownership across five different fields and
  // all five pointed at the same eight people.
  ownedClients       Client[]  @relation("ClientOwner")
  ownedContacts      Contact[] @relation("ContactOwner")
  ownedDeals         Deal[]    @relation("DealOwner")
  createdDeals       Deal[]    @relation("DealCreatedBy")
  leadConsultantOn   Deal[]    @relation("DealLeadConsultant")
  secondConsultantOn Deal[]    @relation("DealSecondaryConsultant")

  @@index([isActive])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- clients

model Client {
  id         String    @id @default(cuid())
  name       String    @unique
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // ------------------------------------------------------------- the CRM
  //
  // A client and a Salesforce account are the same company, so they are one
  // row. Two tables would mean Muck Rack existing twice and the two copies
  // disagreeing inside a month - and it is the same company whether the
  // relationship is a cold prospect or six years of invoices.
  //
  // Everything below is optional, because a client typed into OneSpace by
  // hand has none of it and is not lesser for that.

  /// Salesforce's 18-character id. What makes a re-import an update rather
  /// than a duplicate, and what every relationship in the export resolves
  /// against.
  sfdcId String? @unique

  /// CURRENT_CUSTOMER, not PROSPECT, because somebody typing a client into a
  /// delivery tool by hand means a customer - and because it makes the column
  /// backfill correctly for the clients that existed before the CRM did. The
  /// import overwrites it with the real record type.
  accountType AccountType @default(CURRENT_CUSTOMER)

  /// The name on the contract, where it differs from the name people use.
  legalName String?

  website     String?
  phone       String?
  linkedinUrl String?
  description String?

  /// Free text, deliberately. The export holds 99 distinct values for what
  /// was meant to be a picklist of 24 - so it is imported verbatim and
  /// tidied by a person afterwards, rather than guessed at on the way in.
  industry String?

  employees     Int?
  annualRevenue Decimal? @db.Decimal(14, 2)

  /// From Salesforce's Shipping address, not Billing. Shipping is filled on
  /// 46% of accounts and Billing on 24% - following the field names in the
  /// mapping document would have left half the addresses behind.
  street     String?
  city       String?
  state      String?
  postalCode String?
  country    String?

  /// How they sell, and how big that team is.
  teamSize   Int?
  xdrSize    Int?
  salesRoles String[] @default([])

  /// What they already run. Sparse - 15% - but the 15% is useful.
  technologyUsed String[] @default([])

  /// Who owns the relationship.
  ownerId String?
  owner   User?   @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Which platform this account came through. The same Partner rows the
  /// projects already use, rather than a second list of the same names.
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  /// When Salesforce first knew about them. Distinct from createdAt, which
  /// is when OneSpace did.
  firstSeenAt DateTime?

  projects Project[]
  domains  ClientDomain[]
  mail     MailThread[]
  contacts Contact[]
  deals    Deal[]

  @@index([accountType, name])
}

/**
 * A person at a client.
 * 7,485 of them across 745 accounts, which is the reason this is its own
 * table rather than a field on the client. Most of what Salesforce held
 * about them was empty: pronouns, referral source, thirteen Outreach
 * sequence columns and forty other fields had no value on any row. What is
 * here is what was actually filled in.
 */
model Contact {
  id String @id @default(cuid())

  sfdcId String? @unique

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  firstName String?
  lastName  String
  email     String?
  title     String?

  phone       String?
  mobile      String?
  linkedinUrl String?

  city    String?
  state   String?
  country String?

  /// 165 of them. The single most useful flag in the whole export: it stops
  /// anyone emailing someone who left two years ago.
  noLongerHere Boolean @default(false)

  /// They asked not to be emailed. Kept because the obligation outlives the
  /// system it was recorded in.
  optedOutOfEmail Boolean @default(false)

  notes      String?
  leadSource String?

  ownerId String?
  owner   User?   @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  firstSeenAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  primaryFor   Deal[]            @relation("DealPrimaryContact")
  billingFor   Deal[]            @relation("DealBillingContact")
  partnerAeFor Deal[]            @relation("DealPartnerAe")
  dealRoles    DealContactRole[]

  @@index([clientId, lastName])
  @@index([email])
}

/**
 * A piece of business, won or lost.
 * Called a Deal rather than an Opportunity because that is what people say,
 * and because 98% of these are closed - this is a record of what happened
 * far more than a forecast of what might.
 * The forecast machinery Salesforce carried - probability weighting,
 * forecast categories, stage gating by record type - is deliberately absent.
 * Twenty of 1,269 deals are open. Building a forecast for twenty rows would
 * be building the part of Salesforce that was least used.
 */
model Deal {
  id String @id @default(cuid())

  sfdcId String? @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name  String
  stage DealStage      @default(QUALIFICATION)
  type  DealRecordType @default(DIRECT)

  /// What it was worth. Filled on 99% of deals, and absent from the mapping
  /// document entirely - without it there is no revenue history, which is
  /// the most valuable thing in the export.
  amount    Decimal?  @db.Decimal(14, 2)
  closeDate DateTime?

  /// Amount weighted by the stage's probability. Salesforce computed it;
  /// kept as it stood rather than recomputed, so an old deal still reads the
  /// way it read at the time.
  expectedRevenue Decimal? @db.Decimal(14, 2)

  /// The stage's odds, 0-100. Not used to forecast anything here - twenty
  /// deals are open - but it is what the stage meant on the day.
  probability Int?

  /// Pipeline / Best Case / Commit / Closed / Omitted. The mapping document
  /// listed four of those five and left out Omitted, which is what 472 lost
  /// deals actually carry.
  forecastCategory String?

  /// Salesforce's own fiscal placement, kept because a year read from the
  /// close date and a year read from the fiscal calendar can differ, and
  /// arguments about revenue are usually arguments about which was meant.
  fiscalYear    Int?
  fiscalQuarter Int?

  /// Total quantity across the line items, as Salesforce held it.
  quantity Decimal? @db.Decimal(12, 2)

  isWon    Boolean @default(false)
  isClosed Boolean @default(false)

  /// Salesforce kept platform and business type in one field - Outreach and
  /// Salesloft alongside New Business and Existing Business. They answer
  /// different questions, so they are two fields here.
  partnerId    String?
  partner      Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  /// "New Business" or "Existing Business", where it was recorded.
  businessType String?

  leadSource   String?
  paymentTerms String?
  nextStep     String?
  description  String?

  lostReason       String?
  lostReasonDetail String?

  /// What was sold, in words, when the products didn't cover it.
  customScopeDetail String?
  futurePhaseNotes  String?
  billingNotes      String?

  projectStartDate      DateTime?
  projectCompletionDate DateTime?

  subcontract      Boolean @default(false)
  partnerHold      Boolean @default(false)
  performancePulse Boolean @default(false)

  invoiceSentAt DateTime?
  invoicePaidAt DateTime?
  csatScore     Int?

  ownerId String?
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  leadConsultantId String?
  leadConsultant   User?   @relation("DealLeadConsultant", fields: [leadConsultantId], references: [id], onDelete: SetNull)

  secondaryConsultantId String?
  secondaryConsultant   User?   @relation("DealSecondaryConsultant", fields: [secondaryConsultantId], references: [id], onDelete: SetNull)

  primaryContactId String?
  primaryContact   Contact? @relation("DealPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  billingContactId String?
  billingContact   Contact? @relation("DealBillingContact", fields: [billingContactId], references: [id], onDelete: SetNull)

  /// The partner's account executive - the person at Outreach or Salesloft
  /// who brought the deal. Filled on 762 of the 1,269 deals, and the field
  /// most asked for after the client: on partner business it is who the
  /// relationship actually runs through.
  partnerAeId String?
  partnerAe   Contact? @relation("DealPartnerAe", fields: [partnerAeId], references: [id], onDelete: SetNull)

  /// The project this deal turned into, once it was won. The link that makes
  /// a CRM worth having inside a delivery tool rather than beside one.
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// The id this record had in the Salesforce org before the last migration.
  /// Half the deals carry one, and it is how anything older than that org is
  /// traced.
  legacyId String?

  /// Who made it, and when it last moved. Distinct from OneSpace's own
  /// timestamps, which only know when the import ran.
  createdById String?
  createdBy   User?   @relation("DealCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  lastStageChangeAt DateTime?
  lastActivityAt    DateTime?
  lastModifiedAt    DateTime?

  firstSeenAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines        DealProduct[]
  contactRoles DealContactRole[]

  @@index([clientId, closeDate])
  @@index([stage, closeDate])
}

/**
 * Who played what part on a deal.
 * Its own object in Salesforce and its own table here, because a person can
 * be the billing contact on one deal and the admin on another - the role
 * belongs to the pairing, not to the person.
 */
model DealContactRole {
  id String @id @default(cuid())

  sfdcId String? @unique

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// Billing, Audit, Admin, Sales Leader - whatever the org actually used.
  role String?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([dealId])
}

/**
 * Something RevOptics sells.
 * Imported rather than invented: the export holds the real catalogue, and
 * every entry carries the URL of its statement of work. That link is what
 * lets a won deal propose the right project template instead of asking.
 */
model Product {
  id String @id @default(cuid())

  sfdcId String? @unique

  name        String  @unique
  description String?
  family      String?

  /// Salesforce's own note on how the product is delivered - "Asana &
  /// Salesforce", "Salesforce Only (as product)". It is the closest thing
  /// the data has to "does this become a project".
  delivery String?

  /// The statement of work for this product, as a link.
  sowUrl String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines DealProduct[]
}

/// One product on one deal.
model DealProduct {
  id String @id @default(cuid())

  sfdcId String? @unique

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Kept even when the product no longer exists, so an old deal still says
  /// what was sold.
  productName String?

  quantity   Decimal? @db.Decimal(12, 2)
  unitPrice  Decimal? @db.Decimal(14, 2)
  totalPrice Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([dealId])
}

/**
 * An email domain that means "this client".
 * Domains live on the client rather than the project because a client has one
 * set of them however many engagements they run, and because it is sixty-odd
 * rows to keep straight instead of a hundred and twenty. Which *project* a
 * meeting or an email belongs to is a separate question, answered by the
 * matcher and confirmed by a person.
 */
model ClientDomain {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Lowercase, no "@" - "acme.com". Unique across all clients: one domain
  /// cannot mean two customers, and a duplicate is a data error worth
  /// refusing rather than resolving arbitrarily.
  domain String @unique

  createdAt DateTime @default(now())

  @@index([clientId])
}

// A partner is who the work comes through — Outreach, Salesloft — as distinct
// from the client, who is the end customer the work is actually for. Both
// matter: you report delivery by client and channel performance by partner.
model Partner {
  id         String    @id @default(cuid())
  name       String    @unique
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  projects Project[]
  domains  PartnerDomain[]
  clients  Client[]
  deals    Deal[]
}

/**
 * A domain to stop asking about.
 * Not every outside party is a client or a partner. Recruiters, vendors,
 * networking contacts and the consultancy you swap referrals with all produce
 * meetings that will never be billable to anyone, week after week. Left alone
 * they arrive as suggestions forever and the list stops being worth reading.
 * A meeting whose outside attendees are *all* ignored is not stored at all -
 * so removing a domain from here and re-syncing brings its meetings straight
 * back, rather than leaving a pile of dismissed rows nobody can find.
 */
model IgnoredDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  /// Free text - "recruiters", "referral partner, never billable".
  note      String?
  createdAt DateTime @default(now())
}

/**
 * An email domain belonging to a partner rather than a customer.
 * Partners sit in on other people's meetings - Outreach turns up on a client
 * implementation call, and the meeting is still the client's. Without knowing
 * which domains are partners, two mapped domains in one room look like two
 * customers and the meeting matches neither.
 * A domain may be listed here *and* against a client: Skaled is both the
 * partner work comes through and a customer in its own right. When both are
 * in the room the customer wins; when only Skaled is, it is Skaled's meeting.
 */
model PartnerDomain {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  domain    String   @unique
  createdAt DateTime @default(now())

  @@index([partnerId])
}

// --------------------------------------------------------------- projects

model Project {
  id       String  @id @default(cuid())
  name     String
  code     String? // short code you can type into reports, e.g. ACME-Q3
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  status ProjectStatus @default(ACTIVE)

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  startDate DateTime?
  dueDate   DateTime?

  // Budgets. Either or both may be set; reports show whichever exists.
  budgetHours   Float?
  budgetCents   Int? // revenue budget, or the agreed fee on a fixed-fee project
  billRateCents Int? // overrides the person's billRate for this project

  billingType BillingType @default(HOURLY)

  /// Slack channel this project is discussed in (C…). Status updates post here.
  slackChannelId   String?
  slackChannelName String?

  // Provenance: which template this was spun up from, if any.
  templateId String?
  template   ProjectTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections      Section[]
  tasks         Task[]
  timeEntries   TimeEntry[]
  statusUpdates StatusUpdate[]
  meetings      Meeting[]
  mailThreads   MailThread[]

  /// The deal this project came from, where it came from one. Optional in
  /// both directions: projects predate the CRM, and not every deal becomes
  /// a project.
  deal Deal?

  @@index([clientId])
  @@index([partnerId])
  @@index([status])
  @@index([templateId])
}

model Section {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int     @default(0)

  tasks Task[]

  @@index([projectId, orderIndex])
}

model Task {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  name        String
  description String?
  status      TaskStatus @default(TODO)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Subtasks. One level is all Asana gave us and all anyone wants to read:
  // a parent may have children, a child may not.
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  dueDate        DateTime?
  estimatedHours Float?
  orderIndex     Int       @default(0)
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries TimeEntry[]
  timers      RunningTimer[]
  meetings    Meeting[]
  mailThreads MailThread[]
  commitment  Commitment?

  @@index([projectId, orderIndex])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([parentId])
}

/**
 * A dated check-in on how a project is going. Kept as a history rather than a
 * single mutable field: the value is in seeing that something went from on
 * track to at risk three weeks ago and what was said at the time.
 */
model StatusUpdate {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("StatusUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  health ProjectHealth
  note   String?

  /**
   * The day the update speaks to — not necessarily when it was typed.
   */
  date DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, date])
}

// -------------------------------------------------------------- templates
// A template is the repeatable playbook: sections, tasks, who normally does
// them, how long they normally take, and when they're due relative to kickoff.

model ProjectTemplate {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections TemplateSection[]
  tasks    TemplateTask[]
  projects Project[]
}

model TemplateSection {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int             @default(0)

  tasks TemplateTask[]

  @@index([templateId, orderIndex])
}

model TemplateTask {
  id         String           @id @default(cuid())
  templateId String
  template   ProjectTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    TemplateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  name        String
  description String?

  // Due date = project start date + offsetDays. Null means "no due date".
  offsetDays     Int?
  estimatedHours Float?

  // Mirrors Task: one level of nesting, so a template can carry the checklist
  // under a step rather than flattening it on the way into a project.
  parentId String?
  parent   TemplateTask?  @relation("TemplateSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks TemplateTask[] @relation("TemplateSubtasks")

  defaultAssigneeId String?
  defaultAssignee   User?   @relation("TemplateDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)

  orderIndex Int @default(0)

  @@index([templateId, orderIndex])
  @@index([parentId])
}

// ------------------------------------------------------------------- time

model TimeEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Denormalised so a report never breaks if a task is deleted, and so
  // every report groups by project without an extra join.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Date-only (stored at UTC midnight) — a timesheet day, not an instant.
  date    DateTime
  minutes Int
  notes   String?

  billable Boolean @default(true)

  source TimeEntrySource @default(MANUAL)

  // Rates are snapshotted at write time so historical reports don't change
  // retroactively when someone gets a raise or a client's rate goes up.
  billRateCents Int @default(0)
  costRateCents Int @default(0)

  // Set when the entry came from a stopwatch rather than manual entry.
  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting?

  @@index([userId, date])
  @@index([userId, taskId, date])
  @@index([projectId, date])
  @@index([taskId])
  @@index([date])
}

// One live stopwatch per person.
model RunningTimer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  notes     String?
  startedAt DateTime @default(now())
}

// ------------------------------------------------------- meetings from Google

/**
 * A meeting pulled off someone's Google Calendar, and where OneSpace thinks
 * the time belongs.
 * The row is kept whatever happens to it - accepted, dismissed, or still
 * waiting - for two reasons. Re-syncing must not re-suggest something the
 * person already said no to, and when a meeting is accepted the link back to
 * the time entry is what stops a second sync booking the same hour twice.
 */
model Meeting {
  id String @id @default(cuid())

  /// Whose calendar this came from. A meeting with five people from here
  /// produces five rows, one each, because each of them may book their own
  /// time against a different project.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Google's id for the event. Stable across edits, which is what makes a
  /// re-sync an update rather than a duplicate. Null for a Zoom call that was
  /// never on a calendar.
  googleId String?

  title       String
  description String?

  /// Real instants, not calendar days: a meeting has a clock time, and the
  /// timesheet day is worked out from the person's zone when it is accepted.
  startsAt DateTime
  endsAt   DateTime
  minutes  Int

  /// Who called the meeting, and whether that was this person.
  organizerEmail String?
  isOrganizer    Boolean @default(false)

  /// Every invitee, as [{ email, name, responseStatus }]. Kept whole so the
  /// review screen can show who was actually in the room.
  attendees Json

  /// The outside domains among the attendees, lowercased. This is what the
  /// matcher works from, and what makes an internal meeting recognisable.
  externalDomains String[]

  status SuggestionStatus @default(PENDING)

  /// What the matcher proposed, and in one line why. The reason is shown to
  /// the person: a suggestion you cannot see the basis of is one you either
  /// accept blindly or ignore entirely.
  suggestedClientId  String?
  suggestedProjectId String?
  projectId          String?
  project            Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId             String?
  task               Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  matchReason        String?
  confidence         Int      @default(0)

  /// Set once accepted. Deleting the entry releases the meeting to be
  /// suggested again rather than leaving it silently spent.
  timeEntryId String?    @unique
  timeEntry   TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)

  source MeetingSource @default(CALENDAR)

  /// Zoom's numeric meeting id, and the per-occurrence UUID. The id is lifted
  /// out of the calendar invite's join link; the UUID identifies this
  /// particular sitting of a recurring meeting.
  zoomMeetingId String?
  zoomUuid      String?

  /// What Zoom says actually happened, as opposed to what was booked. A
  /// 60-minute slot that ran 43 minutes is 43 minutes of billable time, and
  /// one that overran to 75 is 75.
  actualMinutes Int?

  /// What the call was about, in a few lines, written from the transcript.
  ///
  /// The transcript itself is still not kept - this is the thing that
  /// replaces it. Worth being deliberate about: a summary is a real record
  /// of a client conversation, so it is shown only to the person whose
  /// meeting it is and to admins, exactly as the meeting itself is.
  summary      String?
  /// The same write-up with its structure kept - overview, headed sections,
  /// action items, outline - so the page can lay it out rather than print a
  /// wall of text. `summary` stays as the rendered version, which is what
  /// gets pasted into a recap email.
  summaryJson  Json?
  /// Which model wrote it, so a change of model is visible in the data.
  summaryModel String?
  summarisedAt DateTime?

  /// Where the recording lives. A link, never a copy - Zoom's retention and
  /// access rules stay in force, and nothing about the call is duplicated
  /// into this database.
  recordingUrl String?

  /// Set once the transcript has been read for commitments. The transcript
  /// itself is not kept: only the sentences someone committed something in.
  transcriptReadAt DateTime?

  /// Why there's no write-up, when there isn't one. "This call wasn't
  /// recorded to the cloud" and "Zoom refused the download" look identical
  /// from the meetings list, and only one of them is worth doing anything
  /// about.
  transcriptNote String?

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  commitments Commitment[]

  @@unique([userId, googleId])
  @@unique([userId, zoomUuid])
  @@index([userId, status, startsAt])
  @@index([projectId])
}

// ------------------------------------------------------------ client email

/**
 * A Gmail thread with a client, treated as a piece of work rather than a
 * message.
 * Only threads involving a domain mapped to a client are ever fetched or
 * stored. Google has no "read mail from these senders only" permission - the
 * grant is the whole mailbox - so the narrowing is done here, on the way in,
 * and everything else is left unread.
 */
model MailThread {
  id String @id @default(cuid())

  /// Whose mailbox. The same client thread reaching three people produces
  /// three rows: each of them has their own reply to write and their own
  /// time to book.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gmailThreadId String

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Set when a person files the thread against a project, or the matcher is
  /// confident enough to propose one.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  subject       String
  /// Sender of the newest message, for the list view.
  lastFrom      String
  lastFromName  String?
  lastMessageAt DateTime
  snippet       String

  /// True when the newest message came from the client rather than from us.
  /// This is the whole point of the inbox: a thread whose last word is
  /// theirs is a thread somebody owes an answer to.
  awaitingUs Boolean @default(true)

  status MailStatus @default(OPEN)

  matchReason String?
  confidence  Int     @default(0)

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages MailMessage[]

  @@unique([userId, gmailThreadId])
  @@index([userId, status, lastMessageAt])
  @@index([projectId])
  @@index([clientId])
}

/**
 * One message in a thread. Stored so the thread can be read and answered
 * without a round trip to Gmail for every open, and so a reply has something
 * to quote.
 */
model MailMessage {
  id       String     @id @default(cuid())
  threadId String
  thread   MailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  gmailMessageId String

  fromEmail String
  fromName  String?
  toEmails  String[]
  ccEmails  String[]
  sentAt    DateTime

  /// Plain text. HTML mail is converted on the way in: rendering a client's
  /// arbitrary HTML inside the app is an injection surface for no gain.
  body String

  /// The RFC Message-ID and References headers. Without them a reply arrives
  /// in the client's mail app as a brand new conversation, which makes a
  /// perfectly good answer look like it ignored the question.
  messageIdHeader  String?
  referencesHeader String?

  /// Sent by someone at RevOptics rather than by the client.
  fromUs Boolean @default(false)

  /// Set on the message this app sent, so a reply written here is not
  /// re-imported as though the client had said something new.
  sentFromOneSpace Boolean @default(false)

  /// Action items lifted out of a recap this message was.
  commitments Commitment[]

  /// Set once the recap rules have been over it, so a re-sync doesn't raise
  /// the same items again after they were dismissed.
  recapReadAt DateTime?

  @@unique([threadId, gmailMessageId])
  @@index([threadId, sentAt])
}

/**
 * Something a RevOptics person said they would do, on a call.
 * "I'll send over the instructions", "let me book another session", "I'll get
 * that ticket raised". The point of the Zoom integration: the transcript is
 * read once, the promises are lifted out of it, and the person who made them
 * gets them back as tasks. What was said is kept - the one sentence, with who
 * said it and when in the call - and the rest of the transcript is not.
 * Nothing here becomes a task on its own. A wrong guess should cost a click,
 * not put words in someone's mouth on a project plan.
 */
model Commitment {
  id String @id @default(cuid())

  /// The call it was said on. Null when it came out of a recap email
  /// instead - a consultant writing up a call they had on the phone, or one
  /// nobody recorded, still commits to things.
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// The recap email it was written in. The other way round from meetingId:
  /// exactly one of the two is set.
  mailMessageId String?
  mailMessage   MailMessage? @relation(fields: [mailMessageId], references: [id], onDelete: Cascade)

  source CommitmentSource @default(TRANSCRIPT)

  /// The sentence itself, as said or as written.
  text String

  /// Who said it, as the transcript names them, and how far into the call -
  /// enough to find the moment in the recording and check the context.
  speaker   String?
  atSeconds Int?

  /// When they said they'd do it, read out of the sentence itself - "by
  /// Friday", "end of next week". Null when nothing was said, in which case
  /// the accept step falls back to three working days and says so.
  dueDate DateTime?

  /// True when dueDate came from the words rather than from that fallback.
  /// The difference matters on screen: an invented date should read as a
  /// question, not as a deadline somebody agreed to.
  dueStated Boolean @default(false)

  /// A tidied version to use as the task name, since "yeah so I'll probably
  /// get that over to you tomorrow" is a promise but a poor task title.
  suggestedTask String

  /// Where it came from: the transcript, or Zoom's own AI summary.
  fromSummary Boolean @default(false)

  status SuggestionStatus @default(PENDING)

  /// Set when accepted, so a re-read can't raise the same task twice.
  taskId String? @unique
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([meetingId, status])
  @@index([mailMessageId])
  @@index([status, dueDate])
}

/// Small key/value store for things there will only ever be one of. Right now
/// that's the timesheet period lock override; keeping it generic saves a
/// migration the next time a single global setting turns up.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
