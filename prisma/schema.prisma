// OneSpace — projects, tasks and time tracking in one place.
// Replaces the Asana (templated projects + task assignment) and
// Everhour (time against tasks + billing reports) pairing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: use the pooled connection (port 6543, ?pgbouncer=true) at runtime
  url       = env("DATABASE_URL")
  // ...and the direct connection (port 5432) for migrations.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// How a project earns. Drives what time logged to it defaults to, and how
/// reports work out what's invoiceable.
enum BillingType {
  /// Invoiced on the hours: revenue is hours x bill rate.
  HOURLY
  /// Invoiced at an agreed price: revenue is the fee, however long it takes.
  FIXED_FEE
  /// Internal work, training, goodwill. Tracked, never invoiced.
  NON_BILLABLE
}

// Where a time entry came from. The timesheet grid may only edit its own
// entries: time booked from a project page, a stopwatch or an import shows
// there as read-only, so filling in a week can add to it but never quietly
// overwrite it.
enum TimeEntrySource {
  TIMESHEET
  MANUAL
  TIMER
  IMPORT
}

// How a project is actually going, which hours and budget alone never say:
// a project can be inside its budget and still off track.
enum ProjectHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

/// Where a suggestion drawn from Google has got to. Nothing reaches a
/// timesheet on a guess: a meeting sits here until the person it belongs to
/// says yes.
enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

// ---------------------------------------------------------------- people

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role    @default(MEMBER)
  isActive     Boolean @default(true)

  // Rates are stored in cents per hour to keep money in integers.
  // costRate = what this person actually costs you (salary loaded, or contractor pay).
  // billRate = default rate you charge a client for their time.
  costRateCents Int @default(0)
  billRateCents Int @default(0)

  /// Slack member id (U…), matched from this person's email. Null until the
  /// workspace is linked, or when someone has no Slack account.
  slackUserId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  assignedTasks Task[]         @relation("TaskAssignee")
  timeEntries   TimeEntry[]
  timer         RunningTimer?
  templateTasks TemplateTask[] @relation("TemplateDefaultAssignee")
  ownedProjects Project[]      @relation("ProjectOwner")
  statusUpdates StatusUpdate[] @relation("StatusUpdateAuthor")
  meetings      Meeting[]

  @@index([isActive])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- clients

model Client {
  id         String    @id @default(cuid())
  name       String    @unique
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  projects Project[]
  domains  ClientDomain[]
}

/**
 * An email domain that means "this client".
 * Domains live on the client rather than the project because a client has one
 * set of them however many engagements they run, and because it is sixty-odd
 * rows to keep straight instead of a hundred and twenty. Which *project* a
 * meeting or an email belongs to is a separate question, answered by the
 * matcher and confirmed by a person.
 */
model ClientDomain {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Lowercase, no "@" - "acme.com". Unique across all clients: one domain
  /// cannot mean two customers, and a duplicate is a data error worth
  /// refusing rather than resolving arbitrarily.
  domain String @unique

  createdAt DateTime @default(now())

  @@index([clientId])
}

// A partner is who the work comes through — Outreach, Salesloft — as distinct
// from the client, who is the end customer the work is actually for. Both
// matter: you report delivery by client and channel performance by partner.
model Partner {
  id         String    @id @default(cuid())
  name       String    @unique
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  projects Project[]
}

// --------------------------------------------------------------- projects

model Project {
  id       String  @id @default(cuid())
  name     String
  code     String? // short code you can type into reports, e.g. ACME-Q3
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  status ProjectStatus @default(ACTIVE)

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  startDate DateTime?
  dueDate   DateTime?

  // Budgets. Either or both may be set; reports show whichever exists.
  budgetHours   Float?
  budgetCents   Int? // revenue budget, or the agreed fee on a fixed-fee project
  billRateCents Int? // overrides the person's billRate for this project

  billingType BillingType @default(HOURLY)

  /// Slack channel this project is discussed in (C…). Status updates post here.
  slackChannelId   String?
  slackChannelName String?

  // Provenance: which template this was spun up from, if any.
  templateId String?
  template   ProjectTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections      Section[]
  tasks         Task[]
  timeEntries   TimeEntry[]
  statusUpdates StatusUpdate[]
  meetings      Meeting[]

  @@index([clientId])
  @@index([partnerId])
  @@index([status])
  @@index([templateId])
}

model Section {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int     @default(0)

  tasks Task[]

  @@index([projectId, orderIndex])
}

model Task {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  name        String
  description String?
  status      TaskStatus @default(TODO)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Subtasks. One level is all Asana gave us and all anyone wants to read:
  // a parent may have children, a child may not.
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  dueDate        DateTime?
  estimatedHours Float?
  orderIndex     Int       @default(0)
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries TimeEntry[]
  timers      RunningTimer[]
  meetings    Meeting[]

  @@index([projectId, orderIndex])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([parentId])
}

/**
 * A dated check-in on how a project is going. Kept as a history rather than a
 * single mutable field: the value is in seeing that something went from on
 * track to at risk three weeks ago and what was said at the time.
 */
model StatusUpdate {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("StatusUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  health ProjectHealth
  note   String?

  /**
   * The day the update speaks to — not necessarily when it was typed.
   */
  date DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, date])
}

// -------------------------------------------------------------- templates
// A template is the repeatable playbook: sections, tasks, who normally does
// them, how long they normally take, and when they're due relative to kickoff.

model ProjectTemplate {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections TemplateSection[]
  tasks    TemplateTask[]
  projects Project[]
}

model TemplateSection {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int             @default(0)

  tasks TemplateTask[]

  @@index([templateId, orderIndex])
}

model TemplateTask {
  id         String           @id @default(cuid())
  templateId String
  template   ProjectTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    TemplateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  name        String
  description String?

  // Due date = project start date + offsetDays. Null means "no due date".
  offsetDays     Int?
  estimatedHours Float?

  // Mirrors Task: one level of nesting, so a template can carry the checklist
  // under a step rather than flattening it on the way into a project.
  parentId String?
  parent   TemplateTask?  @relation("TemplateSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks TemplateTask[] @relation("TemplateSubtasks")

  defaultAssigneeId String?
  defaultAssignee   User?   @relation("TemplateDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)

  orderIndex Int @default(0)

  @@index([templateId, orderIndex])
  @@index([parentId])
}

// ------------------------------------------------------------------- time

model TimeEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Denormalised so a report never breaks if a task is deleted, and so
  // every report groups by project without an extra join.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Date-only (stored at UTC midnight) — a timesheet day, not an instant.
  date    DateTime
  minutes Int
  notes   String?

  billable Boolean @default(true)

  source TimeEntrySource @default(MANUAL)

  // Rates are snapshotted at write time so historical reports don't change
  // retroactively when someone gets a raise or a client's rate goes up.
  billRateCents Int @default(0)
  costRateCents Int @default(0)

  // Set when the entry came from a stopwatch rather than manual entry.
  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting?

  @@index([userId, date])
  @@index([userId, taskId, date])
  @@index([projectId, date])
  @@index([taskId])
  @@index([date])
}

// One live stopwatch per person.
model RunningTimer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  notes     String?
  startedAt DateTime @default(now())
}

// ------------------------------------------------------- meetings from Google

/**
 * A meeting pulled off someone's Google Calendar, and where OneSpace thinks
 * the time belongs.
 * The row is kept whatever happens to it - accepted, dismissed, or still
 * waiting - for two reasons. Re-syncing must not re-suggest something the
 * person already said no to, and when a meeting is accepted the link back to
 * the time entry is what stops a second sync booking the same hour twice.
 */
model Meeting {
  id String @id @default(cuid())

  /// Whose calendar this came from. A meeting with five people from here
  /// produces five rows, one each, because each of them may book their own
  /// time against a different project.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Google's id for the event. Stable across edits, which is what makes a
  /// re-sync an update rather than a duplicate.
  googleId String

  title       String
  description String?

  /// Real instants, not calendar days: a meeting has a clock time, and the
  /// timesheet day is worked out from the person's zone when it is accepted.
  startsAt DateTime
  endsAt   DateTime
  minutes  Int

  /// Who called the meeting, and whether that was this person.
  organizerEmail String?
  isOrganizer    Boolean @default(false)

  /// Every invitee, as [{ email, name, responseStatus }]. Kept whole so the
  /// review screen can show who was actually in the room.
  attendees Json

  /// The outside domains among the attendees, lowercased. This is what the
  /// matcher works from, and what makes an internal meeting recognisable.
  externalDomains String[]

  status SuggestionStatus @default(PENDING)

  /// What the matcher proposed, and in one line why. The reason is shown to
  /// the person: a suggestion you cannot see the basis of is one you either
  /// accept blindly or ignore entirely.
  suggestedClientId  String?
  suggestedProjectId String?
  projectId          String?
  project            Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId             String?
  task               Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  matchReason        String?
  confidence         Int      @default(0)

  /// Set once accepted. Deleting the entry releases the meeting to be
  /// suggested again rather than leaving it silently spent.
  timeEntryId String?    @unique
  timeEntry   TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, googleId])
  @@index([userId, status, startsAt])
  @@index([projectId])
}

/// Small key/value store for things there will only ever be one of. Right now
/// that's the timesheet period lock override; keeping it generic saves a
/// migration the next time a single global setting turns up.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
