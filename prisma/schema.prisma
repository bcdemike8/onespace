// OneSpace — projects, tasks and time tracking in one place.
// Replaces the Asana (templated projects + task assignment) and
// Everhour (time against tasks + billing reports) pairing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: use the pooled connection (port 6543, ?pgbouncer=true) at runtime
  url       = env("DATABASE_URL")
  // ...and the direct connection (port 5432) for migrations.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// How a project earns. Drives what time logged to it defaults to, and how
/// reports work out what's invoiceable.
enum BillingType {
  /// Invoiced on the hours: revenue is hours x bill rate.
  HOURLY
  /// Invoiced at an agreed price: revenue is the fee, however long it takes.
  FIXED_FEE
  /// Internal work, training, goodwill. Tracked, never invoiced.
  NON_BILLABLE
}

// Where a time entry came from. The timesheet grid may only edit its own
// entries: time booked from a project page, a stopwatch or an import shows
// there as read-only, so filling in a week can add to it but never quietly
// overwrite it.
enum TimeEntrySource {
  TIMESHEET
  MANUAL
  TIMER
  IMPORT
}

// How a project is actually going, which hours and budget alone never say:
// a project can be inside its budget and still off track.
enum ProjectHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

/// Where a client email thread has got to as a piece of work.
enum MailStatus {
  /// Waiting on us. Shows on the inbox and counts as something to do.
  OPEN
  /// Dealt with - replied, or judged not to need one.
  DONE
}

/// Where a suggestion drawn from Google has got to. Nothing reaches a
/// timesheet on a guess: a meeting sits here until the person it belongs to
/// says yes.
/// Where a meeting came from. A Zoom call that was never on anyone's
/// calendar - an instant meeting, or a dial into a personal room - is real
/// billable time that the calendar sync can never see.
enum MeetingSource {
  CALENDAR
  ZOOM
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

/// Where a commitment was found. Three places produce them and they carry
/// different weight: a recap the consultant wrote afterwards is the most
/// considered statement of what was agreed, Zoom's own summary had the audio,
/// and the transcript rules are the fallback that works everywhere.
enum CommitmentSource {
  TRANSCRIPT
  ZOOM_SUMMARY
  RECAP_EMAIL
  /// Read out of the transcript by Claude, with a summary kept alongside.
  AI_SUMMARY
}

// ---------------------------------------------------------------- people

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role    @default(MEMBER)
  isActive     Boolean @default(true)

  // Rates are stored in cents per hour to keep money in integers.
  // costRate = what this person actually costs you (salary loaded, or contractor pay).
  // billRate = default rate you charge a client for their time.
  costRateCents Int @default(0)
  billRateCents Int @default(0)

  /// Slack member id (U…), matched from this person's email. Null until the
  /// workspace is linked, or when someone has no Slack account.
  slackUserId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  assignedTasks Task[]         @relation("TaskAssignee")
  timeEntries   TimeEntry[]
  timer         RunningTimer?
  templateTasks TemplateTask[] @relation("TemplateDefaultAssignee")
  ownedProjects Project[]      @relation("ProjectOwner")
  statusUpdates StatusUpdate[] @relation("StatusUpdateAuthor")
  meetings      Meeting[]
  mailThreads   MailThread[]

  @@index([isActive])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- clients

model Client {
  id         String    @id @default(cuid())
  name       String    @unique
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  projects Project[]
  domains  ClientDomain[]
  mail     MailThread[]
}

/**
 * An email domain that means "this client".
 * Domains live on the client rather than the project because a client has one
 * set of them however many engagements they run, and because it is sixty-odd
 * rows to keep straight instead of a hundred and twenty. Which *project* a
 * meeting or an email belongs to is a separate question, answered by the
 * matcher and confirmed by a person.
 */
model ClientDomain {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Lowercase, no "@" - "acme.com". Unique across all clients: one domain
  /// cannot mean two customers, and a duplicate is a data error worth
  /// refusing rather than resolving arbitrarily.
  domain String @unique

  createdAt DateTime @default(now())

  @@index([clientId])
}

// A partner is who the work comes through — Outreach, Salesloft — as distinct
// from the client, who is the end customer the work is actually for. Both
// matter: you report delivery by client and channel performance by partner.
model Partner {
  id         String    @id @default(cuid())
  name       String    @unique
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  projects Project[]
  domains  PartnerDomain[]
}

/**
 * A domain to stop asking about.
 * Not every outside party is a client or a partner. Recruiters, vendors,
 * networking contacts and the consultancy you swap referrals with all produce
 * meetings that will never be billable to anyone, week after week. Left alone
 * they arrive as suggestions forever and the list stops being worth reading.
 * A meeting whose outside attendees are *all* ignored is not stored at all -
 * so removing a domain from here and re-syncing brings its meetings straight
 * back, rather than leaving a pile of dismissed rows nobody can find.
 */
model IgnoredDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  /// Free text - "recruiters", "referral partner, never billable".
  note      String?
  createdAt DateTime @default(now())
}

/**
 * An email domain belonging to a partner rather than a customer.
 * Partners sit in on other people's meetings - Outreach turns up on a client
 * implementation call, and the meeting is still the client's. Without knowing
 * which domains are partners, two mapped domains in one room look like two
 * customers and the meeting matches neither.
 * A domain may be listed here *and* against a client: Skaled is both the
 * partner work comes through and a customer in its own right. When both are
 * in the room the customer wins; when only Skaled is, it is Skaled's meeting.
 */
model PartnerDomain {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  domain    String   @unique
  createdAt DateTime @default(now())

  @@index([partnerId])
}

// --------------------------------------------------------------- projects

model Project {
  id       String  @id @default(cuid())
  name     String
  code     String? // short code you can type into reports, e.g. ACME-Q3
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  status ProjectStatus @default(ACTIVE)

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  startDate DateTime?
  dueDate   DateTime?

  // Budgets. Either or both may be set; reports show whichever exists.
  budgetHours   Float?
  budgetCents   Int? // revenue budget, or the agreed fee on a fixed-fee project
  billRateCents Int? // overrides the person's billRate for this project

  billingType BillingType @default(HOURLY)

  /// Slack channel this project is discussed in (C…). Status updates post here.
  slackChannelId   String?
  slackChannelName String?

  // Provenance: which template this was spun up from, if any.
  templateId String?
  template   ProjectTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections      Section[]
  tasks         Task[]
  timeEntries   TimeEntry[]
  statusUpdates StatusUpdate[]
  meetings      Meeting[]
  mailThreads   MailThread[]

  @@index([clientId])
  @@index([partnerId])
  @@index([status])
  @@index([templateId])
}

model Section {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int     @default(0)

  tasks Task[]

  @@index([projectId, orderIndex])
}

model Task {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  name        String
  description String?
  status      TaskStatus @default(TODO)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Subtasks. One level is all Asana gave us and all anyone wants to read:
  // a parent may have children, a child may not.
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  dueDate        DateTime?
  estimatedHours Float?
  orderIndex     Int       @default(0)
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries TimeEntry[]
  timers      RunningTimer[]
  meetings    Meeting[]
  mailThreads MailThread[]
  commitment  Commitment?

  @@index([projectId, orderIndex])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([parentId])
}

/**
 * A dated check-in on how a project is going. Kept as a history rather than a
 * single mutable field: the value is in seeing that something went from on
 * track to at risk three weeks ago and what was said at the time.
 */
model StatusUpdate {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("StatusUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  health ProjectHealth
  note   String?

  /**
   * The day the update speaks to — not necessarily when it was typed.
   */
  date DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, date])
}

// -------------------------------------------------------------- templates
// A template is the repeatable playbook: sections, tasks, who normally does
// them, how long they normally take, and when they're due relative to kickoff.

model ProjectTemplate {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections TemplateSection[]
  tasks    TemplateTask[]
  projects Project[]
}

model TemplateSection {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int             @default(0)

  tasks TemplateTask[]

  @@index([templateId, orderIndex])
}

model TemplateTask {
  id         String           @id @default(cuid())
  templateId String
  template   ProjectTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    TemplateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  name        String
  description String?

  // Due date = project start date + offsetDays. Null means "no due date".
  offsetDays     Int?
  estimatedHours Float?

  // Mirrors Task: one level of nesting, so a template can carry the checklist
  // under a step rather than flattening it on the way into a project.
  parentId String?
  parent   TemplateTask?  @relation("TemplateSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks TemplateTask[] @relation("TemplateSubtasks")

  defaultAssigneeId String?
  defaultAssignee   User?   @relation("TemplateDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)

  orderIndex Int @default(0)

  @@index([templateId, orderIndex])
  @@index([parentId])
}

// ------------------------------------------------------------------- time

model TimeEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Denormalised so a report never breaks if a task is deleted, and so
  // every report groups by project without an extra join.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Date-only (stored at UTC midnight) — a timesheet day, not an instant.
  date    DateTime
  minutes Int
  notes   String?

  billable Boolean @default(true)

  source TimeEntrySource @default(MANUAL)

  // Rates are snapshotted at write time so historical reports don't change
  // retroactively when someone gets a raise or a client's rate goes up.
  billRateCents Int @default(0)
  costRateCents Int @default(0)

  // Set when the entry came from a stopwatch rather than manual entry.
  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting?

  @@index([userId, date])
  @@index([userId, taskId, date])
  @@index([projectId, date])
  @@index([taskId])
  @@index([date])
}

// One live stopwatch per person.
model RunningTimer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  notes     String?
  startedAt DateTime @default(now())
}

// ------------------------------------------------------- meetings from Google

/**
 * A meeting pulled off someone's Google Calendar, and where OneSpace thinks
 * the time belongs.
 * The row is kept whatever happens to it - accepted, dismissed, or still
 * waiting - for two reasons. Re-syncing must not re-suggest something the
 * person already said no to, and when a meeting is accepted the link back to
 * the time entry is what stops a second sync booking the same hour twice.
 */
model Meeting {
  id String @id @default(cuid())

  /// Whose calendar this came from. A meeting with five people from here
  /// produces five rows, one each, because each of them may book their own
  /// time against a different project.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Google's id for the event. Stable across edits, which is what makes a
  /// re-sync an update rather than a duplicate. Null for a Zoom call that was
  /// never on a calendar.
  googleId String?

  title       String
  description String?

  /// Real instants, not calendar days: a meeting has a clock time, and the
  /// timesheet day is worked out from the person's zone when it is accepted.
  startsAt DateTime
  endsAt   DateTime
  minutes  Int

  /// Who called the meeting, and whether that was this person.
  organizerEmail String?
  isOrganizer    Boolean @default(false)

  /// Every invitee, as [{ email, name, responseStatus }]. Kept whole so the
  /// review screen can show who was actually in the room.
  attendees Json

  /// The outside domains among the attendees, lowercased. This is what the
  /// matcher works from, and what makes an internal meeting recognisable.
  externalDomains String[]

  status SuggestionStatus @default(PENDING)

  /// What the matcher proposed, and in one line why. The reason is shown to
  /// the person: a suggestion you cannot see the basis of is one you either
  /// accept blindly or ignore entirely.
  suggestedClientId  String?
  suggestedProjectId String?
  projectId          String?
  project            Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId             String?
  task               Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  matchReason        String?
  confidence         Int      @default(0)

  /// Set once accepted. Deleting the entry releases the meeting to be
  /// suggested again rather than leaving it silently spent.
  timeEntryId String?    @unique
  timeEntry   TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)

  source MeetingSource @default(CALENDAR)

  /// Zoom's numeric meeting id, and the per-occurrence UUID. The id is lifted
  /// out of the calendar invite's join link; the UUID identifies this
  /// particular sitting of a recurring meeting.
  zoomMeetingId String?
  zoomUuid      String?

  /// What Zoom says actually happened, as opposed to what was booked. A
  /// 60-minute slot that ran 43 minutes is 43 minutes of billable time, and
  /// one that overran to 75 is 75.
  actualMinutes Int?

  /// What the call was about, in a few lines, written from the transcript.
  ///
  /// The transcript itself is still not kept - this is the thing that
  /// replaces it. Worth being deliberate about: a summary is a real record
  /// of a client conversation, so it is shown only to the person whose
  /// meeting it is and to admins, exactly as the meeting itself is.
  summary      String?
  /// Which model wrote it, so a change of model is visible in the data.
  summaryModel String?
  summarisedAt DateTime?

  /// Where the recording lives. A link, never a copy - Zoom's retention and
  /// access rules stay in force, and nothing about the call is duplicated
  /// into this database.
  recordingUrl String?

  /// Set once the transcript has been read for commitments. The transcript
  /// itself is not kept: only the sentences someone committed something in.
  transcriptReadAt DateTime?

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  commitments Commitment[]

  @@unique([userId, googleId])
  @@unique([userId, zoomUuid])
  @@index([userId, status, startsAt])
  @@index([projectId])
}

// ------------------------------------------------------------ client email

/**
 * A Gmail thread with a client, treated as a piece of work rather than a
 * message.
 * Only threads involving a domain mapped to a client are ever fetched or
 * stored. Google has no "read mail from these senders only" permission - the
 * grant is the whole mailbox - so the narrowing is done here, on the way in,
 * and everything else is left unread.
 */
model MailThread {
  id String @id @default(cuid())

  /// Whose mailbox. The same client thread reaching three people produces
  /// three rows: each of them has their own reply to write and their own
  /// time to book.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gmailThreadId String

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Set when a person files the thread against a project, or the matcher is
  /// confident enough to propose one.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  subject       String
  /// Sender of the newest message, for the list view.
  lastFrom      String
  lastFromName  String?
  lastMessageAt DateTime
  snippet       String

  /// True when the newest message came from the client rather than from us.
  /// This is the whole point of the inbox: a thread whose last word is
  /// theirs is a thread somebody owes an answer to.
  awaitingUs Boolean @default(true)

  status MailStatus @default(OPEN)

  matchReason String?
  confidence  Int     @default(0)

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages MailMessage[]

  @@unique([userId, gmailThreadId])
  @@index([userId, status, lastMessageAt])
  @@index([projectId])
  @@index([clientId])
}

/**
 * One message in a thread. Stored so the thread can be read and answered
 * without a round trip to Gmail for every open, and so a reply has something
 * to quote.
 */
model MailMessage {
  id       String     @id @default(cuid())
  threadId String
  thread   MailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  gmailMessageId String

  fromEmail String
  fromName  String?
  toEmails  String[]
  ccEmails  String[]
  sentAt    DateTime

  /// Plain text. HTML mail is converted on the way in: rendering a client's
  /// arbitrary HTML inside the app is an injection surface for no gain.
  body String

  /// The RFC Message-ID and References headers. Without them a reply arrives
  /// in the client's mail app as a brand new conversation, which makes a
  /// perfectly good answer look like it ignored the question.
  messageIdHeader  String?
  referencesHeader String?

  /// Sent by someone at RevOptics rather than by the client.
  fromUs Boolean @default(false)

  /// Set on the message this app sent, so a reply written here is not
  /// re-imported as though the client had said something new.
  sentFromOneSpace Boolean @default(false)

  /// Action items lifted out of a recap this message was.
  commitments Commitment[]

  /// Set once the recap rules have been over it, so a re-sync doesn't raise
  /// the same items again after they were dismissed.
  recapReadAt DateTime?

  @@unique([threadId, gmailMessageId])
  @@index([threadId, sentAt])
}

/**
 * Something a RevOptics person said they would do, on a call.
 * "I'll send over the instructions", "let me book another session", "I'll get
 * that ticket raised". The point of the Zoom integration: the transcript is
 * read once, the promises are lifted out of it, and the person who made them
 * gets them back as tasks. What was said is kept - the one sentence, with who
 * said it and when in the call - and the rest of the transcript is not.
 * Nothing here becomes a task on its own. A wrong guess should cost a click,
 * not put words in someone's mouth on a project plan.
 */
model Commitment {
  id String @id @default(cuid())

  /// The call it was said on. Null when it came out of a recap email
  /// instead - a consultant writing up a call they had on the phone, or one
  /// nobody recorded, still commits to things.
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// The recap email it was written in. The other way round from meetingId:
  /// exactly one of the two is set.
  mailMessageId String?
  mailMessage   MailMessage? @relation(fields: [mailMessageId], references: [id], onDelete: Cascade)

  source CommitmentSource @default(TRANSCRIPT)

  /// The sentence itself, as said or as written.
  text String

  /// Who said it, as the transcript names them, and how far into the call -
  /// enough to find the moment in the recording and check the context.
  speaker   String?
  atSeconds Int?

  /// When they said they'd do it, read out of the sentence itself - "by
  /// Friday", "end of next week". Null when nothing was said, in which case
  /// the accept step falls back to three working days and says so.
  dueDate DateTime?

  /// True when dueDate came from the words rather than from that fallback.
  /// The difference matters on screen: an invented date should read as a
  /// question, not as a deadline somebody agreed to.
  dueStated Boolean @default(false)

  /// A tidied version to use as the task name, since "yeah so I'll probably
  /// get that over to you tomorrow" is a promise but a poor task title.
  suggestedTask String

  /// Where it came from: the transcript, or Zoom's own AI summary.
  fromSummary Boolean @default(false)

  status SuggestionStatus @default(PENDING)

  /// Set when accepted, so a re-read can't raise the same task twice.
  taskId String? @unique
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([meetingId, status])
  @@index([mailMessageId])
  @@index([status, dueDate])
}

/// Small key/value store for things there will only ever be one of. Right now
/// that's the timesheet period lock override; keeping it generic saves a
/// migration the next time a single global setting turns up.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
